# ============================================================
# baboonPaperForge — Environment Variables (TEMPLATE)
# Copy this to `.env` and fill in your actual values.
# WARNING: `.env` MUST NOT be committed to Git.
# ============================================================

# --- Application ---
APP_NAME=baboonPaperForge
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-fernet-key

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=baboonforge

# Async connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# --- Milvus (Vector DB) ---
MILVUS_HOST=localhost
MILVUS_PORT=19530

# --- LLM Provider Defaults ---
# Supported: openai | anthropic | gemini | ollama
DEFAULT_LLM_PROVIDER=openai

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Paths ---
TEMPLATE_WORKDIR=./workdir
